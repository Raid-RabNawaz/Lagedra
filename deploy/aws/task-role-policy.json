{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3Access",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::lagedra-evidence-prod",
        "arn:aws:s3:::lagedra-evidence-prod/*",
        "arn:aws:s3:::lagedra-exports-prod",
        "arn:aws:s3:::lagedra-exports-prod/*",
        "arn:aws:s3:::lagedra-health-probe",
        "arn:aws:s3:::lagedra-health-probe/*"
      ]
    },
    {
      "Sid": "SSMReadOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:*:*:parameter/lagedra/*"
    },
    {
      "Sid": "SecretsManagerRead",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:*:*:secret:/lagedra/*"
    }
  ]
}
