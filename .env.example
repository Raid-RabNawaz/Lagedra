# ============================================================
# Lagedra — Environment Variable Template
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=lagedra
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=lagedra_db
POSTGRES_PORT=5432

# ── Ports ────────────────────────────────────────────────────
API_HTTP_PORT=8080
WEB_PORT=3000
ADMIN_PORT=3001
MARKETING_PORT=3002
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
CLAMAV_PORT=3310

# ── ASP.NET Core ─────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ── JWT ──────────────────────────────────────────────────────
# Must be at least 32 characters long
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_ISSUER=https://lagedra.com
JWT_AUDIENCE=https://lagedra.com

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Google Maps ──────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIza...

# ── Persona (KYC + Background Check) ────────────────────────
PERSONA_API_KEY=persona_sandbox_...
PERSONA_WEBHOOK_SECRET=persona_webhook_secret_...

# ── Twilio (SMS via Messaging API + email via SendGrid) ──────
# SMS: Account SID (AC…) + Messaging Service SID (MG…) + either
# Auth Token OR API Key SID (SK…) + API Key secret.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Email (Twilio SendGrid): create an API key in SendGrid (SG…)
TWILIO_SENDGRID_API_KEY=SG.xxxxxxxx
TWILIO_FROM_EMAIL=info@lagedra.com
TWILIO_FROM_NAME=Lagedra

# ── Channel / PMS integrations ───────────────────────────────
# OwnerRez API v2. Leave ClientId/ClientSecret unset (the current setup): hosts connect by
# pasting their own OwnerRez API key, so no platform-level credentials are needed. Two limits
# come with that, both from ownerrez.com/support/articles/api-auth — OwnerRez caps API keys at
# two accounts per IP per 24 hours, and it sends webhooks only to OAuth apps, so booking
# changes arrive via the polling job rather than /v1/webhooks/ownerrez.
# Setting ClientId/ClientSecret (from an OAuth app under Settings → Advanced Tools →
# Developer/API Settings) switches hosts to the authorize flow and hides the key form; the
# app's redirect URL must then match {App__BaseUrl}/v1/channels/ownerrez/oauth/callback
# exactly, and WebhookUsername/Password must match the app's Webhooks section or deliveries
# to /v1/webhooks/ownerrez are rejected.
# Channels__OwnerRez__BaseUrl=https://api.ownerrez.com
# Channels__OwnerRez__ClientId=
# Channels__OwnerRez__ClientSecret=
# Channels__OwnerRez__WebhookUsername=
# Channels__OwnerRez__WebhookPassword=
# Hostaway: only base URL is platform-level; hosts paste account ID + API secret in-app
# Channels__Hostaway__BaseUrl=https://api.hostaway.com
# Channels__Hostaway__DefaultChannelId=2000
# Channels__Hostaway__AutoRegisterWebhooks=true
# Optional Basic auth Hostaway sends to POST /v1/webhooks/hostaway
# Channels__Hostaway__WebhookUsername=lagedra
# Channels__Hostaway__WebhookPassword=change_me
# Guesty Open API: hosts paste Client ID + Client Secret from Integrations → API & Webhooks
# Channels__Guesty__BaseUrl=https://open-api.guesty.com
# Channels__Guesty__ReservationSource=manual
# Hosthub public API: hosts paste an API key from Settings → API keys (account owner).
# Default is production Hosthub. Point at https://eric.hosthub.com to use Hosthub staging.
# Channels__Hosthub__BaseUrl=https://app.hosthub.com
# Channels__Hosthub__SourceId=

# ── MinIO (S3-compatible object storage) ─────────────────────
MINIO_ROOT_USER=lagedra_minio
MINIO_ROOT_PASSWORD=change_me_in_prod_minio
MINIO_BUCKET_NAME=lagedra-evidence

# ── Site URL ─────────────────────────────────────────────────
SITE_URL=http://localhost:3002

# ── Insurance API (Phase 5.6) ────────────────────────────────
INSURANCE_API_BASE_URL=https://api.insuranceprovider.example.com
INSURANCE_API_KEY=your_insurance_api_key
