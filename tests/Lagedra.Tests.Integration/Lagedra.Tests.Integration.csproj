<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test code intentionally relaxes the strict production analyzer gates. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1062;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lagedra.Modules\LeaseAgreements\LeaseAgreements.csproj" />
    <ProjectReference Include="..\..\src\Lagedra.Modules\InsuranceIntegration\InsuranceIntegration.csproj" />
    <ProjectReference Include="..\..\src\Lagedra.Modules\JurisdictionPacks\JurisdictionPacks.csproj" />
  </ItemGroup>

</Project>
