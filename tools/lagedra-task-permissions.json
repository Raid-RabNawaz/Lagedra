{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ListAllBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListAllMyBuckets"],
      "Resource": "*"
    },
    {
      "Sid": "S3Access",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::lagedra-private-prod",
        "arn:aws:s3:::lagedra-private-prod/*",
        "arn:aws:s3:::lagedra-public-prod",
        "arn:aws:s3:::lagedra-public-prod/*",
        "arn:aws:s3:::lagedra-health-probe",
        "arn:aws:s3:::lagedra-health-probe/*"
      ]
    },
    {
      "Sid": "SSMReadOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:*:*:parameter/lagedra/*"
    },
    {
      "Sid": "SecretsManagerRead",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:*:*:secret:/lagedra/*"
    }
  ]
}
